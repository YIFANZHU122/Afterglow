[gd_resource type="Resource" script_class="AreaDefinition" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/data/encounter_spawn_definition.gd" id="1_spawn_definition"]
[ext_resource type="Script" path="res://scripts/data/encounter_definition.gd" id="2_encounter_definition"]
[ext_resource type="Script" path="res://scripts/data/area_definition.gd" id="3_area_definition"]
[ext_resource type="PackedScene" path="res://scenes/objects/training_dummy/training_dummy.tscn" id="4_dummy_scene"]
[ext_resource type="PackedScene" path="res://scenes/objects/chaser_enemy/chaser_enemy.tscn" id="5_chaser_scene"]

[sub_resource type="Resource" id="Resource_spawn_dummy"]
script = ExtResource("1_spawn_definition")
entity_scene = ExtResource("4_dummy_scene")
spawn_position = Vector2(1500, 860)

[sub_resource type="Resource" id="Resource_spawn_chaser"]
script = ExtResource("1_spawn_definition")
entity_scene = ExtResource("5_chaser_scene")
spawn_position = Vector2(1100, 520)

[sub_resource type="Resource" id="Resource_encounter"]
script = ExtResource("2_encounter_definition")
objective_text = "击败全部敌人"
spawns = Array[Resource]([SubResource("Resource_spawn_dummy"), SubResource("Resource_spawn_chaser")])

[resource]
script = ExtResource("3_area_definition")
id = &"basement"
display_name = "地下室"
encounter = SubResource("Resource_encounter")
